<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ShotMark</AssemblyName>
    <RootNamespace>ShotMark.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ShotMark.ico</ApplicationIcon>
    <Product>ShotMark</Product>
    <Version>1.0.0</Version>
    <!-- WPF-App: DPI-Modus kommt aus app.manifest (PerMonitorV2), nicht aus WinForms -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms nur für NotifyIcon; globale Usings vermeiden Namenskonflikte mit WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShotMark.Core\ShotMark.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ShotMark.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShotMark.App.Tests" />
  </ItemGroup>

  <!-- Installation und automatische Updates (GitHub Releases) -->
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Eigener Main in App.xaml.cs: Velopack muss vor WPF laufen (Installations-/Update-Hooks) -->
  <PropertyGroup>
    <StartupObject>ShotMark.App.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>
