<Window x:Class="ShotMark.App.Settings.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotMark – Einstellungen" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/ShotMark;component/Assets/ShotMark.ico"
        Style="{StaticResource DarkWindow}" Background="{StaticResource PanelBrush}">
    <StackPanel Margin="28,22,28,24">
        <TextBlock Text="Einstellungen" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Gelten nur für diesen PC." Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,4,0,0" />

        <TextBlock Text="Name dieses PCs" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
        <TextBox x:Name="NameBox" MaxLength="40" TextChanged="OnNameChanged" AutomationProperties.Name="Name dieses PCs" />
        <TextBlock x:Name="NamePreview" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />

        <TextBlock Text="Tastenkürzel" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Aufnahme" VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBox x:Name="HotkeyBox" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand"
                     PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"
                     GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur"
                     AutomationProperties.Name="Tastenkürzel für die Aufnahme" />
            <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Content="Druck-Taste" Margin="8,0,0,0" Click="OnResetHotkey"
                    ToolTip="Auf die Druck-Taste zurücksetzen" />

            <TextBlock Grid.Row="1" Text="Scroll-Aufnahme" VerticalAlignment="Center" Margin="0,8,14,0" />
            <TextBox x:Name="ScrollHotkeyBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand"
                     PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"
                     GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur"
                     AutomationProperties.Name="Tastenkürzel für die Scroll-Aufnahme" />
            <Button x:Name="ScrollToggleButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource OutlineButton}" Margin="8,8,0,0"
                    Click="OnToggleScrollHotkey" />
        </Grid>
        <TextBlock x:Name="HotkeyHint" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />

        <TextBlock Text="Speicherordner" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Style="{StaticResource OutlineButton}" Content="Ändern …" Click="OnPickFolder" />
            </StackPanel>
            <TextBox x:Name="FolderBox" IsReadOnly="True" AutomationProperties.Name="Speicherordner" />
        </DockPanel>
        <DockPanel Margin="0,6,0,0">
            <Button x:Name="AutoFolderButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Automatisch (Dropbox)"
                    Foreground="{StaticResource AccentBrush}" FontSize="12" Padding="6,2" Click="OnAutoFolder" />
            <TextBlock x:Name="FolderHint" Foreground="{StaticResource TextFaintBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Text="Verhalten" Style="{StaticResource SectionLabel}" Margin="0,22,0,10" />
        <CheckBox x:Name="AutostartBox" Content="ShotMark mit Windows starten" />
        <TextBlock x:Name="AutostartHint" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="28,4,0,0" TextWrapping="Wrap" />
        <CheckBox x:Name="ClipboardBox" Content="Fertiges Bild nach der Aufnahme in die Zwischenablage kopieren" Margin="0,12,0,0" />

        <Border x:Name="ErrorBox" Margin="0,18,0,0" Padding="12,10" CornerRadius="6" Background="#3A1E20"
                BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource OutlineButton}" Content="Abbrechen" IsCancel="True" Margin="0,0,8,0" Padding="16,8" />
            <Button Style="{StaticResource PrimaryButton}" Content="Speichern" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
