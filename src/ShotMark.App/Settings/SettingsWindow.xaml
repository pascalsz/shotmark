<Window x:Class="ShotMark.App.Settings.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ShotMark.App.Localization;assembly=ShotMark.App.Strings"
        Title="{x:Static loc:Strings.Settings_WindowTitle}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/ShotMark;component/Assets/ShotMark.ico"
        Style="{StaticResource DarkWindow}" Background="{StaticResource PanelBrush}">
    <StackPanel Margin="28,22,28,24">
        <TextBlock Text="{x:Static loc:Strings.Settings_Title}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{x:Static loc:Strings.Settings_Subtitle}" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,4,0,0" />

        <TextBlock Text="{x:Static loc:Strings.Settings_PcName}" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
        <TextBox x:Name="NameBox" MaxLength="40" TextChanged="OnNameChanged" AutomationProperties.Name="{x:Static loc:Strings.Settings_PcName}" />
        <TextBlock x:Name="NamePreview" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />

        <TextBlock Text="{x:Static loc:Strings.Settings_Hotkeys}" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Static loc:Strings.Settings_Capture}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBox x:Name="HotkeyBox" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand"
                     PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"
                     GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur"
                     AutomationProperties.Name="{x:Static loc:Strings.Settings_CaptureHotkeyName}" />
            <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Content="{x:Static loc:Strings.Settings_PrintScreenButton}" Margin="8,0,0,0" Click="OnResetHotkey"
                    ToolTip="{x:Static loc:Strings.Settings_PrintScreenTip}" />

            <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.Settings_ScrollCapture}" VerticalAlignment="Center" Margin="0,8,14,0" />
            <TextBox x:Name="ScrollHotkeyBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand"
                     PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"
                     GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur"
                     AutomationProperties.Name="{x:Static loc:Strings.Settings_ScrollHotkeyName}" />
            <Button x:Name="ScrollToggleButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource OutlineButton}" Margin="8,8,0,0"
                    Click="OnToggleScrollHotkey" />
        </Grid>
        <TextBlock x:Name="HotkeyHint" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />

        <TextBlock Text="{x:Static loc:Strings.Settings_SaveFolder}" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Style="{StaticResource OutlineButton}" Content="{x:Static loc:Strings.Settings_Change}" Click="OnPickFolder" />
            </StackPanel>
            <TextBox x:Name="FolderBox" IsReadOnly="True" AutomationProperties.Name="{x:Static loc:Strings.Settings_SaveFolder}" />
        </DockPanel>
        <DockPanel Margin="0,6,0,0">
            <Button x:Name="AutoFolderButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{x:Static loc:Strings.Settings_AutoFolder}"
                    Foreground="{StaticResource AccentBrush}" FontSize="12" Padding="6,2" Click="OnAutoFolder" />
            <TextBlock x:Name="FolderHint" Foreground="{StaticResource TextFaintBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Text="{x:Static loc:Strings.Settings_Behavior}" Style="{StaticResource SectionLabel}" Margin="0,22,0,10" />
        <CheckBox x:Name="AutostartBox" Content="{x:Static loc:Strings.Settings_Autostart}" />
        <TextBlock x:Name="AutostartHint" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="28,4,0,0" TextWrapping="Wrap" />
        <CheckBox x:Name="ClipboardBox" Content="{x:Static loc:Strings.Settings_Clipboard}" Margin="0,12,0,0" />
        <CheckBox x:Name="UpdatesBox" Content="{x:Static loc:Strings.Settings_CheckForUpdates}" Margin="0,12,0,0" />
        <TextBlock Text="{x:Static loc:Strings.Settings_UpdatesHint}" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="28,4,0,0" TextWrapping="Wrap" />

        <TextBlock Text="{x:Static loc:Strings.Settings_Language}" Style="{StaticResource SectionLabel}" Margin="0,22,0,10" />
        <WrapPanel>
            <RadioButton x:Name="LanguageAuto" Style="{StaticResource Chip}" GroupName="Language" Margin="0,0,6,6"
                         Content="{x:Static loc:Strings.Settings_LanguageAuto}" />
            <!-- Sprachnamen stehen immer in der eigenen Sprache -->
            <RadioButton x:Name="LanguageGerman" Style="{StaticResource Chip}" GroupName="Language" Margin="0,0,6,6" Content="Deutsch" />
            <RadioButton x:Name="LanguageEnglish" Style="{StaticResource Chip}" GroupName="Language" Margin="0,0,6,6" Content="English" />
        </WrapPanel>
        <TextBlock Text="{x:Static loc:Strings.Settings_LanguageHint}" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />

        <Border x:Name="ErrorBox" Margin="0,18,0,0" Padding="12,10" CornerRadius="6" Background="#3A1E20"
                BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" />
        </Border>

        <DockPanel Margin="0,24,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource OutlineButton}" Content="{x:Static loc:Strings.Common_Cancel}" IsCancel="True" Margin="0,0,8,0" Padding="16,8" />
                <Button Style="{StaticResource PrimaryButton}" Content="{x:Static loc:Strings.Common_Save}" IsDefault="True" Click="OnSave" />
            </StackPanel>
            <TextBlock x:Name="VersionText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="{StaticResource TextFaintBrush}" FontSize="12" />
        </DockPanel>
    </StackPanel>
</Window>
