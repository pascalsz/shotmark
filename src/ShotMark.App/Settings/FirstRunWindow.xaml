<Window x:Class="ShotMark.App.Settings.FirstRunWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ShotMark.App.Localization;assembly=ShotMark.App.Strings"
        Title="{x:Static loc:Strings.FirstRun_WindowTitle}" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/ShotMark;component/Assets/ShotMark.ico"
        Style="{StaticResource DarkWindow}" Background="{StaticResource PanelBrush}">
    <StackPanel Margin="30,28,30,26">
        <Image Source="pack://application:,,,/ShotMark;component/Assets/ShotMark.ico" Width="44" Height="44" HorizontalAlignment="Left" />
        <TextBlock Text="{x:Static loc:Strings.FirstRun_Welcome}" FontSize="21" FontWeight="SemiBold" Margin="0,16,0,8" />
        <TextBlock Text="{x:Static loc:Strings.FirstRun_Intro}" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" LineHeight="20" />

        <TextBlock Text="{x:Static loc:Strings.Settings_PcName}" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
        <TextBox x:Name="NameBox" TextChanged="OnNameChanged" MaxLength="40" AutomationProperties.Name="{x:Static loc:Strings.Settings_PcName}" />
        <TextBlock x:Name="Preview" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="Warning" Foreground="#F0B429" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <Border Margin="0,22,0,0" Padding="14,12" CornerRadius="8" Background="{StaticResource BarBrush}">
            <TextBlock x:Name="FolderInfo" Foreground="{StaticResource TextDimBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
        </Border>

        <!-- Datenschutzhinweis zur automatischen Update-Prüfung (Pflicht für die SignPath-Signatur) -->
        <Border Margin="0,10,0,0" Padding="14,12" CornerRadius="8" Background="{StaticResource BarBrush}">
            <TextBlock Text="{x:Static loc:Strings.FirstRun_UpdatesNote}" Foreground="{StaticResource TextDimBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button Style="{StaticResource OutlineButton}" Content="{x:Static loc:Strings.Common_Cancel}" IsCancel="True" Margin="0,0,8,0" Padding="16,8" />
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="{x:Static loc:Strings.FirstRun_Start}" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
