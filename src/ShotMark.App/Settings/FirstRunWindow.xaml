<Window x:Class="ShotMark.App.Settings.FirstRunWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotMark einrichten" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/ShotMark;component/Assets/ShotMark.ico"
        Style="{StaticResource DarkWindow}" Background="{StaticResource PanelBrush}">
    <StackPanel Margin="30,28,30,26">
        <Image Source="pack://application:,,,/ShotMark;component/Assets/ShotMark.ico" Width="44" Height="44" HorizontalAlignment="Left" />
        <TextBlock Text="Willkommen bei ShotMark" FontSize="21" FontWeight="SemiBold" Margin="0,16,0,8" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" LineHeight="20">
            Wie soll dieser PC heißen? Der Name steht im Dateinamen und im Verlauf. So siehst du später,
            auf welchem Rechner ein Screenshot entstanden ist.
        </TextBlock>

        <TextBlock Text="Name dieses PCs" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
        <TextBox x:Name="NameBox" TextChanged="OnNameChanged" MaxLength="40" AutomationProperties.Name="Name dieses PCs" />
        <TextBlock x:Name="Preview" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="Warning" Foreground="#F0B429" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <Border Margin="0,22,0,0" Padding="14,12" CornerRadius="8" Background="{StaticResource BarBrush}">
            <TextBlock x:Name="FolderInfo" Foreground="{StaticResource TextDimBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button Style="{StaticResource OutlineButton}" Content="Abbrechen" IsCancel="True" Margin="0,0,8,0" Padding="16,8" />
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="Los geht’s" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
