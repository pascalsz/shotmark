<Window x:Class="ShotMark.App.Editor.EditorWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ShotMark.App.Localization;assembly=ShotMark.App.Strings"
        xmlns:ed="clr-namespace:ShotMark.App.Editor"
        xmlns:h="clr-namespace:ShotMark.App.History"
        Title="ShotMark" Width="1320" Height="860" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/ShotMark;component/Assets/ShotMark.ico"
        Style="{StaticResource DarkWindow}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ToolIconFilled" TargetType="Path" BasedOn="{StaticResource ToolIcon}">
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>

        <Style x:Key="CommandButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type h:CaptureTileVm}">
            <Grid Width="132" ToolTip="{Binding ToolTipText}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border CornerRadius="4" Background="#121214" ClipToBounds="True">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,5,0,1">
                    <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}"
                             ToolTip="{x:Static loc:Strings.Editor_CapturedHere}"
                             Visibility="{Binding IsOwnPc, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding TimeText}" FontSize="11.5" />
                    <TextBlock Text=" · " FontSize="11.5" Foreground="{StaticResource TextFaintBrush}" />
                    <TextBlock Text="{Binding PcLabel}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                               MaxWidth="78" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type h:DayHeaderVm}">
            <Grid Width="22" Height="100" IsHitTestVisible="False" Margin="0,0,2,0">
                <Border Width="1" HorizontalAlignment="Left" Background="{StaticResource LineBrush}" Margin="0,4" />
                <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Werkzeugleiste -->
        <Border Grid.Row="0" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NewCaptureButton" Style="{StaticResource CommandButton}" Width="84" Click="OnNewCapture">
                        <StackPanel>
                            <Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconCapture}" />
                            <TextBlock Style="{StaticResource ToolLabel}" Text="{x:Static loc:Strings.Editor_CaptureGroup}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="ToolSelect" Style="{StaticResource ToolButton}" GroupName="Tools" Tag="Select" ToolTip="{x:Static loc:Strings.Tip_Select}" Checked="OnToolChecked">
                        <StackPanel>
                            <Path Style="{StaticResource ToolIconFilled}" Data="{StaticResource IconSelect}" />
                            <TextBlock Style="{StaticResource ToolLabel}" Text="{x:Static loc:Strings.Tool_Select}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ToolRectangle" Style="{StaticResource ToolButton}" GroupName="Tools" Tag="Rectangle" ToolTip="{x:Static loc:Strings.Tip_Rectangle}" Checked="OnToolChecked">
                        <StackPanel>
                            <Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconRectangle}" />
                            <TextBlock Style="{StaticResource ToolLabel}" Text="{x:Static loc:Strings.Tool_Rectangle}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ToolArrow" Style="{StaticResource ToolButton}" GroupName="Tools" Tag="Arrow" ToolTip="{x:Static loc:Strings.Tip_Arrow}" Checked="OnToolChecked">
                        <StackPanel>
                            <Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconArrow}" />
                            <TextBlock Style="{StaticResource ToolLabel}" Text="{x:Static loc:Strings.Tool_Arrow}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ToolCheck" Style="{StaticResource ToolButton}" GroupName="Tools" Tag="Check" ToolTip="{x:Static loc:Strings.Tip_Check}" Checked="OnToolChecked">
                        <StackPanel>
                            <Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconCheck}" StrokeThickness="2.2" />
                            <TextBlock Style="{StaticResource ToolLabel}" Text="{x:Static loc:Strings.Tool_Check}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ToolCross" Style="{StaticResource ToolButton}" GroupName="Tools" Tag="Cross" ToolTip="{x:Static loc:Strings.Tip_Cross}" Checked="OnToolChecked">
                        <StackPanel>
                            <Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconCross}" StrokeThickness="2.2" />
                            <TextBlock Style="{StaticResource ToolLabel}" Text="{x:Static loc:Strings.Tool_Cross}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ToolText" Style="{StaticResource ToolButton}" GroupName="Tools" Tag="Text" ToolTip="{x:Static loc:Strings.Tip_Text}" Checked="OnToolChecked">
                        <StackPanel>
                            <Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconText}" />
                            <TextBlock Style="{StaticResource ToolLabel}" Text="{x:Static loc:Strings.Tool_Text}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ToolBlur" Style="{StaticResource ToolButton}" GroupName="Tools" Tag="Blur" ToolTip="{x:Static loc:Strings.Tip_Blur}" Checked="OnToolChecked" Width="84">
                        <StackPanel>
                            <Path Style="{StaticResource ToolIconFilled}" Data="{StaticResource IconBlur}" StrokeThickness="0" Opacity="0.9" />
                            <TextBlock Style="{StaticResource ToolLabel}" Text="{x:Static loc:Strings.Tool_Blur}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ToolCrop" Style="{StaticResource ToolButton}" GroupName="Tools" Tag="Crop" ToolTip="{x:Static loc:Strings.Tip_Crop}" Checked="OnToolChecked" Width="84">
                        <StackPanel>
                            <Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconCrop}" />
                            <TextBlock Style="{StaticResource ToolLabel}" Text="{x:Static loc:Strings.Tool_Crop}" />
                        </StackPanel>
                    </RadioButton>

                    <Border Width="1" Height="32" Margin="10,0" Background="{StaticResource LineBrush}" />

                    <Button x:Name="UndoButton" Style="{StaticResource CommandButton}" ToolTip="{x:Static loc:Strings.Tip_Undo}" Click="OnUndo">
                        <StackPanel>
                            <Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconUndo}" />
                            <TextBlock Style="{StaticResource ToolLabel}" Text="{x:Static loc:Strings.Editor_Undo}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource CommandButton}" ToolTip="{x:Static loc:Strings.Tip_Redo}" Click="OnRedo">
                        <StackPanel>
                            <Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconRedo}" />
                            <TextBlock Style="{StaticResource ToolLabel}" Text="{x:Static loc:Strings.Editor_Redo}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CopyButton" Style="{StaticResource OutlineButton}" Margin="0,0,6,0" ToolTip="{x:Static loc:Strings.Tip_Copy}" Click="OnCopy">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconCopy}" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource TextBrush}" />
                            <TextBlock x:Name="CopyLabel" Text="{x:Static loc:Strings.Editor_Copy}" Margin="8,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" ToolTip="{x:Static loc:Strings.Editor_OpenFolder}" Click="OnOpenFolder" Padding="8"
                            AutomationProperties.Name="{x:Static loc:Strings.Editor_OpenFolder}">
                        <Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconFolder}" Stroke="{StaticResource TextDimBrush}" />
                    </Button>
                    <Button Style="{StaticResource FlatButton}" ToolTip="{x:Static loc:Strings.Editor_Settings}" Click="OnSettings" Padding="8"
                            AutomationProperties.Name="{x:Static loc:Strings.Editor_Settings}">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource SymbolFont}" FontSize="18" Foreground="{StaticResource TextDimBrush}"
                                   Width="22" Height="22" TextAlignment="Center" Padding="0,2,0,0" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Arbeitsbereich -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PanelColumn" Width="252" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource CanvasBrush}" Focusable="False" PreviewMouseWheel="OnScrollerWheel"
                          SizeChanged="OnScrollerSizeChanged">
                <Grid x:Name="CanvasHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                    <Border x:Name="ImageShadow" Background="#0E0E0F">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black" />
                        </Border.Effect>
                    </Border>
                    <ed:AnnotationCanvas x:Name="Board" />
                    <Canvas x:Name="TextLayer" />
                </Grid>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconCapture}" Width="48" Height="48" Stretch="Uniform"
                      Stroke="{StaticResource TextFaintBrush}" StrokeThickness="1.5" />
                <TextBlock Text="{x:Static loc:Strings.Editor_NoCaptureOpen}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                <TextBlock x:Name="EmptyHint" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Style="{StaticResource PrimaryButton}" Content="{x:Static loc:Strings.Editor_NewCapture}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="OnNewCapture" />
            </StackPanel>

            <Border x:Name="ConflictBanner" VerticalAlignment="Top" Margin="16" Padding="14,10" CornerRadius="8"
                    Background="#3A1E20" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Visibility="Collapsed" MaxWidth="760">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{StaticResource OutlineButton}" Content="{x:Static loc:Strings.Editor_Reload}" Margin="0,0,8,0" Click="OnConflictReload"
                                ToolTip="{x:Static loc:Strings.Tip_Reload}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static loc:Strings.Editor_SaveAsCopy}" Click="OnConflictCopy"
                                ToolTip="{x:Static loc:Strings.Tip_SaveAsCopy}" />
                    </StackPanel>
                    <TextBlock x:Name="ConflictText" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border x:Name="WarningBanner" VerticalAlignment="Top" Margin="16" Padding="14,10" CornerRadius="8"
                    Background="#3A3220" BorderBrush="#C9A227" BorderThickness="1" Visibility="Collapsed" MaxWidth="760">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{x:Static loc:Strings.Common_OK}" Margin="12,0,0,0" Click="OnDismissWarning" />
                    <TextBlock x:Name="WarningText" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Eigenschaften -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="18,14,18,18">
                        <TextBlock x:Name="PanelTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="PanelHint" Foreground="{StaticResource TextDimBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="17" />

                        <StackPanel x:Name="ColorSection">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static loc:Strings.Editor_Color}" />
                            <WrapPanel x:Name="Swatches" />
                        </StackPanel>

                        <StackPanel x:Name="SizeSection">
                            <Grid>
                                <TextBlock x:Name="SizeLabel" Style="{StaticResource SectionLabel}" Text="{x:Static loc:Strings.Editor_Strength}" />
                                <TextBlock x:Name="SizeValue" HorizontalAlignment="Right" Margin="0,16,0,8" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" />
                            </Grid>
                            <Slider x:Name="SizeSlider" Minimum="1" Maximum="20" SmallChange="1" LargeChange="2" ValueChanged="OnSizeChanged"
                                    AutomationProperties.Name="{x:Static loc:Strings.Editor_Size}" />
                        </StackPanel>

                        <StackPanel x:Name="CropSection" Margin="0,18,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{x:Static loc:Strings.Editor_CropApply}" Click="OnCropApply" />
                            <Button Style="{StaticResource OutlineButton}" Content="{x:Static loc:Strings.Editor_CropCancel}" Margin="0,8,0,0" Click="OnCropCancel" />
                            <Button x:Name="RemoveCropButton" Style="{StaticResource FlatButton}" Content="{x:Static loc:Strings.Editor_CropRemove}" Margin="0,8,0,0"
                                    Foreground="{StaticResource TextDimBrush}" Click="OnCropRemove" />
                        </StackPanel>

                        <StackPanel x:Name="SelectionSection" Margin="0,22,0,0">
                            <Button Style="{StaticResource OutlineButton}" Click="OnDelete" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconTrash}" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource TextBrush}" />
                                    <TextBlock Text="{x:Static loc:Strings.Editor_Delete}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="CropInfoSection" Margin="0,22,0,0">
                            <Button Style="{StaticResource FlatButton}" Content="{x:Static loc:Strings.Editor_CropRemove}" HorizontalAlignment="Left"
                                    Foreground="{StaticResource TextDimBrush}" Padding="0,4" Click="OnCropRemove"
                                    ToolTip="{x:Static loc:Strings.Tip_CropRemove}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Statuszeile -->
        <Border Grid.Row="2" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0" Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" FontSize="12" />
                    <Button x:Name="RetryButton" Style="{StaticResource FlatButton}" Content="{x:Static loc:Strings.Editor_Retry}" Padding="8,2" Margin="8,0,0,0"
                            Foreground="{StaticResource AccentBrush}" FontSize="12" Click="OnRetrySave" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="FileText" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="24,0"
                           VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="ZoomControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SizeText" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource FlatButton}" Content="−" Padding="8,0" FontSize="14" ToolTip="{x:Static loc:Strings.Tip_ZoomOut}" Click="OnZoomOut" />
                    <TextBlock x:Name="ZoomText" Width="52" TextAlignment="Center" FontSize="12" VerticalAlignment="Center" />
                    <Button Style="{StaticResource FlatButton}" Content="+" Padding="8,0" FontSize="14" ToolTip="{x:Static loc:Strings.Tip_ZoomIn}" Click="OnZoomIn" />
                    <Button Style="{StaticResource FlatButton}" Content="{x:Static loc:Strings.Editor_Fit}" Padding="8,2" FontSize="12" Margin="4,0,0,0" ToolTip="{x:Static loc:Strings.Tip_Fit}" Click="OnZoomFit" />
                    <Button Style="{StaticResource FlatButton}" Content="100 %" Padding="8,2" FontSize="12" ToolTip="{x:Static loc:Strings.Tip_ActualSize}" Click="OnZoomActual" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Verlauf -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="14,8,14,4">
                    <TextBlock Text="{x:Static loc:Strings.History_Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="HistorySummary" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="10,0,16,0" VerticalAlignment="Center" />
                    <ItemsControl x:Name="FilterChips" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type h:PcFilterVm}">
                                <RadioButton Style="{StaticResource Chip}" GroupName="PcFilter" Content="{Binding Label}"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}" Checked="OnFilterChecked" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <ListBox x:Name="HistoryList" Grid.Row="1" Height="112" Margin="10,0,10,8" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource HistoryItem}" SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionChanged="OnHistorySelectionChanged" PreviewMouseWheel="OnHistoryWheel"
                         AutomationProperties.Name="{x:Static loc:Strings.History_Title}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock x:Name="HistoryEmpty" Grid.Row="1" Margin="14,0,14,14" Foreground="{StaticResource TextFaintBrush}" FontSize="12"
                           Text="{x:Static loc:Strings.History_Empty}" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
